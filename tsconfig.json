{
	"include": ["./src/**/*"],
	"compilerOptions": {
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["jest", "node"],
		"rootDir": "src",
		"module": "NodeNext",
		"outDir": "dist",
		"target": "es2022",
		"declaration": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"strict": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noImplicitOverride": true,
		"lib": ["es2022", "dom", "dom.iterable"]
	}
}
